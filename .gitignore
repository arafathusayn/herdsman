# The web app is built into the binary at release time, never committed.
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# goreleaser output and local builds
/dist/
/bin/
/sdk/ts/dist/

# The pinned Go tools, installed by make tools-go.
/.tools/

# setup-zig restores this cache before GoReleaser checks for a clean tree.
/.zig-cache/
