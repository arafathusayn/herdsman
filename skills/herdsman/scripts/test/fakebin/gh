#!/bin/bash
# Fake gh for the herdsman pull request watcher test. It prints the fixture that the real command's
# --jq filter would print, one line for each item, from $FAKE_GH_DIR (a missing file means no items):
#   gh api repos/<repo>/issues/<n>/comments  ->  <n>-comments.txt   ("comment <id> <login>")
#   gh api repos/<repo>/pulls/<n>/comments   ->  <n>-inline.txt     ("inline <id> <login> <path>")
#   gh api repos/<repo>/pulls/<n>/reviews    ->  <n>-reviews.txt    ("review <id> <login> <state>")
#   gh pr view <n> ...                       ->  <n>-view.txt       ("state ...", "head ...", "check <name>=<result>")
# Two additions for the watcher tests:
#   <n>-view.json  is the raw JSON of `gh pr view <n> --json state,headRefOid,statusCheckRollup`. The fake runs the
#                  command's own --jq filter on it with jq, so the test covers the filter itself. It wins over <n>-view.txt.
#   <n>-fail       (any content) makes every call for pull request <n> fail with exit 1, as a refused read does.
if [ "$1" = "api" ]; then
  case "$2" in
    */issues/*/comments) n=${2#*/issues/}; kind=comments ;;
    */pulls/*/comments) n=${2#*/pulls/}; kind=inline ;;
    */pulls/*/reviews) n=${2#*/pulls/}; kind=reviews ;;
    *) echo "fake gh: unsupported $*" >&2; exit 1 ;;
  esac
  n=${n%%/*}
elif [ "$1 $2" = "pr view" ]; then
  n=$3; kind=view
else
  echo "fake gh: unsupported $*" >&2
  exit 1
fi
if [ -f "$FAKE_GH_DIR/$n-fail" ]; then
  echo "fake gh: HTTP 502 for pull request $n" >&2
  exit 1
fi
if [ "$kind" = view ] && [ -f "$FAKE_GH_DIR/$n-view.json" ]; then
  filter=""
  while [ $# -gt 0 ]; do
    [ "$1" = "--jq" ] && filter=$2
    shift
  done
  jq -r "$filter" "$FAKE_GH_DIR/$n-view.json"
  exit $?
fi
f="$FAKE_GH_DIR/$n-$kind.txt"
[ -f "$f" ] && cat "$f"
exit 0
