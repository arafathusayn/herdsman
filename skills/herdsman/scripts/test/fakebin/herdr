#!/bin/bash
# Fake herdr for the herdsman watcher tests: `herdr pane read <id> ...` prints $FAKE_PANE_DIR/<id>.txt
# and `herdr agent get <name>` prints the session record with the id in $FAKE_SESSION (empty when unset).
# With $FIXTURE set (the message tests), it logs every call to $FIXTURE/calls.log and serves the message
# channel calls from files in that folder: agents.json (pane id to agent record), and the switches
# get-failure, get-invalid, metadata-failure, toast-disabled and read-failure, and screen-<pane> for `pane read`.
# Every input call fails and stays in the log, except an exact `/goal resume` prompt when allow-resume exists,
# and any prompt when allow-prompt exists (the checkpointer cases; drift-after-prompt then changes that session).
# `agent wait` returns at once.
if [ -n "${FIXTURE:-}" ]; then
  # One line per call: a newline inside an argument becomes a space.
  line=$*; printf '%s\n' "${line//$'\n'/ }" >> "$FIXTURE/calls.log"
  case "$1 $2" in
    'agent get')
      if [ -f "$FIXTURE/get-failure" ]; then echo '{"error":{"code":"temporary_failure"}}'; exit 1; fi
      if [ -f "$FIXTURE/get-invalid" ]; then echo 'invalid JSON'; exit 0; fi
      if ! jq -e --arg p "$3" 'has($p)' "$FIXTURE/agents.json" >/dev/null; then
        echo '{"error":{"code":"pane_not_found"}}'; exit 1
      fi
      jq -c --arg p "$3" '{id:"fixture-response",result:{type:"agent_info",agent:.[$p]}}' "$FIXTURE/agents.json"
      exit 0 ;;
    'agent list')
      jq -c '{id:"fixture-response",result:{type:"agent_list",agents:[.[]]}}' "$FIXTURE/agents.json"
      exit 0 ;;
    'pane report-metadata')
      if [ -f "$FIXTURE/metadata-failure" ]; then echo '{"error":{"code":"unavailable"}}'; exit 1; fi
      echo '{"id":"fixture-response","result":{"type":"ok"}}'
      exit 0 ;;
    'notification show')
      if [ -f "$FIXTURE/toast-disabled" ]; then
        echo '{"id":"fixture-response","result":{"type":"notification_show","shown":false,"reason":"disabled"}}'
      else
        echo '{"id":"fixture-response","result":{"type":"notification_show","shown":true}}'
      fi
      exit 0 ;;
    'pane read')
      if [ -f "$FIXTURE/read-failure" ]; then echo '{"error":{"code":"unavailable"}}'; exit 1; fi
      if [ -f "$FIXTURE/screen-$3" ]; then cat "$FIXTURE/screen-$3"; else echo 'idle prompt'; fi
      exit 0 ;;
    'pane list')
      # Every fixture pane sits in one focused tab, so the resume helper can capture and restore it.
      jq -c '{id:"fixture-response",result:{type:"pane_list",panes:[.[]|{pane_id,tab_id,focused:true}]}}' "$FIXTURE/agents.json"
      exit 0 ;;
    'tab focus')
      echo '{"id":"fixture-response","result":{"type":"ok"}}'
      exit 0 ;;
    'agent wait')
      echo '{"id":"fixture-response","result":{"type":"ok"}}'
      exit 0 ;;
    'agent prompt')
      # Only the exact goal resume, and only where the case allows it; the pane then shows a working turn.
      if [ -f "$FIXTURE/allow-resume" ] && [ $# = 4 ] && [ "$4" = '/goal resume' ]; then
        echo 'Working' > "$FIXTURE/screen-$3"
        echo '{"id":"fixture-response","result":{"type":"ok"}}'
        exit 0
      fi
      # The checkpointer cases accept prompts; drift-after-prompt then changes that pane's session.
      if [ -f "$FIXTURE/allow-prompt" ]; then
        if [ -f "$FIXTURE/drift-after-prompt" ]; then
          jq --arg p "$3" '.[$p].agent_session.value="drifted-session"' "$FIXTURE/agents.json" > "$FIXTURE/agents.tmp" &&
            mv "$FIXTURE/agents.tmp" "$FIXTURE/agents.json"
        fi
        echo '{"id":"fixture-response","result":{"type":"ok"}}'
        exit 0
      fi ;;
  esac
  echo '{"error":{"code":"unsupported_fake_call"}}'
  exit 98
fi
if [ "$1" = "pane" ] && [ "$2" = "read" ]; then
  f="$FAKE_PANE_DIR/$3.txt"
  [ -f "$f" ] && cat "$f"
  exit 0
fi
if [ "$1" = "agent" ] && [ "$2" = "get" ]; then
  printf '{"result":{"agent":{"agent_session":{"value":"%s"}}}}\n' "${FAKE_SESSION:-}"
  exit 0
fi
echo "fake herdr: unsupported $*" >&2
exit 1
