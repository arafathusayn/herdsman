#!/bin/bash
# Fault-injecting jq for the message tests: a call whose arguments contain the first line of $FIXTURE/fail-jq
# prints {} and fails, as a producer that writes output and then exits nonzero.
here=$(cd "$(dirname "$0")" && pwd)
real() { local d IFS=:; for d in $PATH; do [ "$d" = "$here" ] && continue; [ -x "$d/$1" ] && { printf '%s\n' "$d/$1"; return 0; }; done; return 127; }
if [ -f "$FIXTURE/fail-jq" ]; then
  IFS= read -r needle < "$FIXTURE/fail-jq"
  case "$*" in *"$needle"*) printf '{}\n'; exit 1 ;; esac
fi
exec "$(real jq)" "$@"
