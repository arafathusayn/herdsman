#!/bin/bash
# Fault-injecting cat for the message tests: with $FIXTURE/fail-cat, reading any .md file fails.
here=$(cd "$(dirname "$0")" && pwd)
real() { local d IFS=:; for d in $PATH; do [ "$d" = "$here" ] && continue; [ -x "$d/$1" ] && { printf '%s\n' "$d/$1"; return 0; }; done; return 127; }
if [ -f "$FIXTURE/fail-cat" ]; then
  case "$*" in *'.md'*) exit 1 ;; esac
fi
exec "$(real cat)" "$@"
