#!/bin/bash
# GNU stat stand-in for the message tests: with $FIXTURE/stat-gnu, only the GNU form `stat -c %Y|%a <file>` works
# and the BSD form fails, so the scripts' GNU branch runs on any system. With $FIXTURE/stat-fail, stat fails for the
# paths it names. Without either, the real stat runs.
here=$(cd "$(dirname "$0")" && pwd)
real() { local d IFS=:; for d in $PATH; do [ "$d" = "$here" ] && continue; [ -x "$d/$1" ] && { printf '%s\n' "$d/$1"; return 0; }; done; return 127; }
st=$(real stat)
# With $FIXTURE/stat-fail, a path that contains one of its lines fails, as a file that vanished after its listing.
if [ -f "$FIXTURE/stat-fail" ]; then
  last=${!#}
  while IFS= read -r pat; do [ -z "$pat" ] || case "$last" in *"$pat"*) exit 1 ;; esac; done < "$FIXTURE/stat-fail"
fi
if [ -f "$FIXTURE/stat-gnu" ]; then
  [ "$1" = -c ] || exit 2
  if "$st" -c %Y / >/dev/null 2>&1; then exec "$st" "$@"; fi
  case "$2" in %Y) exec "$st" -f %m "$3" ;; %a) exec "$st" -f %Lp "$3" ;; esac
  exit 2
fi
exec "$st" "$@"
