## never default
printf '' > /route/.steps/op-1/1.start && claude update; rc=$?; printf %s $rc > /route/.steps/op-1/1.rc; printf 'herdsman-step %s rc=%s\n' 1 $rc
## never explicit
printf '' > /route/.steps/op-1/2.start && npm ci; rc=$?; printf %s $rc > /route/.steps/op-1/2.rc; printf 'herdsman-step %s rc=%s\n' 2 $rc
## idempotent
printf '' > /route/.steps/op-1/3.start && make deps; rc=$?; printf %s $rc > /route/.steps/op-1/3.rc; printf 'herdsman-step %s rc=%s\n' 3 $rc
## once
printf '' > /route/.steps/op-1/4.start && db migrate; rc=$?; printf %s $rc > /route/.steps/op-1/4.rc; printf 'herdsman-step %s rc=%s\n' 4 $rc
## probe
printf '' > /route/.steps/op-1/5.start && db seed; rc=$?; printf %s $rc > /route/.steps/op-1/5.rc; printf 'herdsman-step %s rc=%s\n' 5 $rc
## probe (its probe)
printf '' > /route/.steps/op-1/5.probe.start && db seeded; rc=$?; printf %s $rc > /route/.steps/op-1/5.probe.rc; printf 'herdsman-step %s rc=%s\n' 5.probe $rc
## command-local environment
printf '' > /route/.steps/op-1/6.start && K=V L='a b' npm ci; rc=$?; printf %s $rc > /route/.steps/op-1/6.rc; printf 'herdsman-step %s rc=%s\n' 6 $rc
## hostile value
printf '' > /route/.steps/op-1/7.start && echo '; touch x' '$(touch x)' '`touch x`' 'it'\''s'; rc=$?; printf %s $rc > /route/.steps/op-1/7.rc; printf 'herdsman-step %s rc=%s\n' 7 $rc
## assignment-like program
printf '' > /route/.steps/op-1/8.start && 'K=V' --flag=v '=zsh'; rc=$?; printf %s $rc > /route/.steps/op-1/8.rc; printf 'herdsman-step %s rc=%s\n' 8 $rc
## reserved word program
printf '' > /route/.steps/op-1/9.start && 'if' x; rc=$?; printf %s $rc > /route/.steps/op-1/9.rc; printf 'herdsman-step %s rc=%s\n' 9 $rc
## empty argument
printf '' > /route/.steps/op-1/10.start && a ''; rc=$?; printf %s $rc > /route/.steps/op-1/10.rc; printf 'herdsman-step %s rc=%s\n' 10 $rc
## hostile folder
printf '' > '/route x/it'\''s/.steps/$(op)/11.start' && a; rc=$?; printf %s $rc > '/route x/it'\''s/.steps/$(op)/11.rc'; printf 'herdsman-step %s rc=%s\n' 11 $rc
