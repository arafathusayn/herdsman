{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true
  },
  "include": ["./*.ts", "./node_modules/thane/client.d.ts"],
  "exclude": ["./build.ts"]
}
