{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@reactre/core",
    "paths": {
      "@reactre/core": ["./vendor/reactre/packages/core/src/index.ts"],
      "@reactre/core/server": ["./vendor/reactre/packages/core/src/server.browser.ts"],
      "@reactre/core/*": ["./vendor/reactre/packages/core/src/*"],
      "@reactre/dom": ["./vendor/reactre/packages/dom/src/index.ts"],
      "@herdsman/sdk": ["../sdk/ts/src/client.ts"],
      "@herdsman/sdk/*": ["../sdk/ts/src/generated/*.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun-types"]
  },
  "include": ["src", "build.ts", "build.test.ts", "reactre.ts", "test-fixtures"]
}
