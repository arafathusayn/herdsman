{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@reactre/core",
    "paths": {
      "@reactre/core": ["./vendor/reactre/packages/core/src/index.ts"],
      "@reactre/core/server": ["./vendor/reactre/packages/core/src/server.browser.ts"],
      "@reactre/core/*": ["./vendor/reactre/packages/core/src/*"],
      "@reactre/dom": ["./vendor/reactre/packages/dom/src/index.ts"],
      "@herdsman/sdk": ["../sdk/ts/src/client.ts"],
      "@herdsman/sdk/*": ["../sdk/ts/src/generated/*.ts"],
      "@reactre/state": ["./vendor/reactre/packages/state/src/index.ts"],
      "@reactre/state/run": ["./vendor/reactre/packages/state/src/run.ts"],
      "@reactre/state/run-nested": ["./vendor/reactre/packages/state/src/run-nested.ts"],
      "@reactre/state/tasks": ["./vendor/reactre/packages/state/src/tasks.ts"],
      "@reactre/state/dev": ["./vendor/reactre/packages/state/src/dev.ts"],
      "@reactre/state/signals": ["./vendor/reactre/packages/state/src/signals.ts"],
      "@reactre/state/always": ["./vendor/reactre/packages/state/src/features/always/index.ts"],
      "@reactre/state/children": ["./vendor/reactre/packages/state/src/features/children/index.ts"],
      "@reactre/state/children/saved": ["./vendor/reactre/packages/state/src/features/children/saved.ts"],
      "@reactre/state/choice": ["./vendor/reactre/packages/state/src/features/choice/index.ts"],
      "@reactre/state/delays": ["./vendor/reactre/packages/state/src/features/delays/index.ts"],
      "@reactre/state/durable": ["./vendor/reactre/packages/state/src/features/durable/index.ts"],
      "@reactre/state/effects": ["./vendor/reactre/packages/state/src/features/effects/index.ts"],
      "@reactre/state/emit": ["./vendor/reactre/packages/state/src/features/emit/index.ts"],
      "@reactre/state/history": ["./vendor/reactre/packages/state/src/features/history/index.ts"],
      "@reactre/state/inspect": ["./vendor/reactre/packages/state/src/features/inspect/index.ts"],
      "@reactre/state/logic": ["./vendor/reactre/packages/state/src/features/logic/index.ts"],
      "@reactre/state/nested": ["./vendor/reactre/packages/state/src/features/nested/index.ts"],
      "@reactre/state/output": ["./vendor/reactre/packages/state/src/features/output/index.ts"],
      "@reactre/state/parallel": ["./vendor/reactre/packages/state/src/features/parallel/index.ts"],
      "@reactre/state/persist": ["./vendor/reactre/packages/state/src/features/persist/index.ts"],
      "@reactre/state/provide": ["./vendor/reactre/packages/state/src/features/provide/index.ts"],
      "@reactre/state/reenter": ["./vendor/reactre/packages/state/src/features/reenter/index.ts"],
      "@reactre/state/route": ["./vendor/reactre/packages/state/src/features/route/index.ts"],
      "@reactre/state/spawn": ["./vendor/reactre/packages/state/src/features/spawn/index.ts"],
      "@reactre/state/system": ["./vendor/reactre/packages/state/src/features/system/index.ts"],
      "@reactre/state/tags": ["./vendor/reactre/packages/state/src/features/tags/index.ts"],
      "@reactre/state/timeout": ["./vendor/reactre/packages/state/src/features/timeout/index.ts"],
      "@reactre/state/validate": ["./vendor/reactre/packages/state/src/features/validate/index.ts"],
      "@reactre/state/wildcards": ["./vendor/reactre/packages/state/src/features/wildcards/index.ts"],
      "@reactre/state/delays/saved": ["./vendor/reactre/packages/state/src/features/delays/saved.ts"],
      "@reactre/state/durable/children": ["./vendor/reactre/packages/state/src/features/durable/children.ts"],
      "@reactre/state/spawn/restore": ["./vendor/reactre/packages/state/src/features/spawn/restore.ts"],
      "@reactre/state/validate/decided": ["./vendor/reactre/packages/state/src/features/validate/decided.ts"],
      "@reactre/state/serialize": ["./vendor/reactre/packages/state/src/entries/serialize.ts"],
      "@reactre/state/scxml": ["./vendor/reactre/packages/state/src/entries/scxml.ts"],
      "@reactre/state/graph": ["./vendor/reactre/packages/state/src/entries/graph.ts"],
      "@reactre/state/test": ["./vendor/reactre/packages/state/src/entries/test.ts"],
      "@reactre/state/react": ["./vendor/reactre/packages/state/src/entries/react.ts"],
      "@reactre/state/react/dev": ["./vendor/reactre/packages/state/src/entries/react-dev.ts"],
      "@reactre/state/utils": ["./vendor/reactre/packages/state/src/utils/index.ts"],
      "@reactre/state/utils/*": ["./vendor/reactre/packages/state/src/utils/*.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun-types"]
  },
  "include": ["src", "build.ts", "*.test.ts", "reactre.ts", "test-fixtures"]
}
