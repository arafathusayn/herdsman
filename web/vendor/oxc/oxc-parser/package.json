{
  "name": "oxc-parser",
  "version": "0.156.0",
  "description": "Oxc Parser Node API",
  "keywords": [
    "ast",
    "estree",
    "javascript",
    "oxc",
    "parser",
    "typescript"
  ],
  "homepage": "https://oxc.rs/docs/guide/usage/parser",
  "bugs": "https://github.com/oxc-project/oxc/issues",
  "license": "MIT",
  "author": "Boshen and oxc contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxc-project/oxc.git",
    "directory": "napi/parser"
  },
  "funding": {
    "url": "https://github.com/sponsors/oxc-project"
  },
  "files": [
    "src-js/bindings.js",
    "src-js/index.d.ts",
    "src-js/index.js",
    "src-js/wasm.d.ts",
    "src-js/wasm.js",
    "src-js/webcontainer-fallback.cjs",
    "src-js/wrap.js",
    "src-js/generated/constants.js",
    "src-js/raw-transfer/common.js",
    "src-js/raw-transfer/eager.js",
    "src-js/raw-transfer/lazy-common.js",
    "src-js/raw-transfer/lazy.js",
    "src-js/raw-transfer/node-array.js",
    "src-js/raw-transfer/supported.js",
    "src-js/raw-transfer/visitor.js",
    "src-js/visit/index.js",
    "src-js/visit/visitor.js",
    "src-js/generated/deserialize/js.js",
    "src-js/generated/deserialize/js_range.js",
    "src-js/generated/deserialize/ts.js",
    "src-js/generated/deserialize/ts_range.js",
    "src-js/generated/lazy/constructors.js",
    "src-js/generated/lazy/type_ids.js",
    "src-js/generated/lazy/walk.js",
    "src-js/generated/visit/keys.js",
    "src-js/generated/visit/type_ids.js",
    "src-js/generated/visit/visitor.d.ts",
    "src-js/generated/visit/walk.js",
    "parser.wasm32-wasip1.workerd.mjs",
    "parser.wasm32-wasip1.workerd.d.mts",
    "parser.wasm32-wasip1.wasm",
    "parser.wasm32-wasip1.wasm.d.mts"
  ],
  "type": "module",
  "main": "src-js/index.js",
  "browser": "src-js/wasm.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@oxc-project/types": "^0.156.0"
  },
  "napi": {
    "binaryName": "parser",
    "dtsHeaderFile": "src-js/header.d.ts",
    "packageName": "@oxc-parser/binding",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-linux-android",
      "aarch64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "aarch64-unknown-linux-ohos",
      "armv7-linux-androideabi",
      "armv7-unknown-linux-gnueabihf",
      "armv7-unknown-linux-musleabihf",
      "i686-pc-windows-msvc",
      "powerpc64le-unknown-linux-gnu",
      "riscv64gc-unknown-linux-gnu",
      "riscv64gc-unknown-linux-musl",
      "s390x-unknown-linux-gnu",
      "wasm32-wasip1",
      "wasm32-wasip1-threads",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-freebsd",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ],
    "wasm": {
      "browser": {
        "fs": false
      }
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-darwin-arm64": "0.156.0",
    "@oxc-parser/binding-linux-arm64-gnu": "0.156.0",
    "@oxc-parser/binding-linux-arm64-musl": "0.156.0",
    "@oxc-parser/binding-darwin-x64": "0.156.0",
    "@oxc-parser/binding-linux-x64-gnu": "0.156.0",
    "@oxc-parser/binding-linux-x64-musl": "0.156.0"
  },
  "exports": {
    ".": {
      "browser": "./src-js/wasm.js",
      "import": "./src-js/index.js",
      "node": "./src-js/index.js",
      "default": "./src-js/index.js"
    },
    "./*": "./*",
    "./src-js/bindings": "./src-js/bindings.js",
    "./src-js/generated/constants": "./src-js/generated/constants.js",
    "./src-js/generated/deserialize/js": "./src-js/generated/deserialize/js.js",
    "./src-js/generated/deserialize/js_range": "./src-js/generated/deserialize/js_range.js",
    "./src-js/generated/deserialize/ts": "./src-js/generated/deserialize/ts.js",
    "./src-js/generated/deserialize/ts_range": "./src-js/generated/deserialize/ts_range.js",
    "./src-js/generated/lazy/constructors": "./src-js/generated/lazy/constructors.js",
    "./src-js/generated/lazy/type_ids": "./src-js/generated/lazy/type_ids.js",
    "./src-js/generated/lazy/walk": "./src-js/generated/lazy/walk.js",
    "./src-js/generated/visit/keys": "./src-js/generated/visit/keys.js",
    "./src-js/generated/visit/type_ids": "./src-js/generated/visit/type_ids.js",
    "./src-js/generated/visit/walk": "./src-js/generated/visit/walk.js",
    "./src-js/index": "./src-js/index.js",
    "./src-js/raw-transfer/common": "./src-js/raw-transfer/common.js",
    "./src-js/raw-transfer/eager": "./src-js/raw-transfer/eager.js",
    "./src-js/raw-transfer/lazy-common": "./src-js/raw-transfer/lazy-common.js",
    "./src-js/raw-transfer/lazy": "./src-js/raw-transfer/lazy.js",
    "./src-js/raw-transfer/node-array": "./src-js/raw-transfer/node-array.js",
    "./src-js/raw-transfer/supported": "./src-js/raw-transfer/supported.js",
    "./src-js/raw-transfer/visitor": "./src-js/raw-transfer/visitor.js",
    "./src-js/visit/index": "./src-js/visit/index.js",
    "./src-js/visit/visitor": "./src-js/visit/visitor.js",
    "./src-js/wasm": "./src-js/wasm.js",
    "./src-js/wrap": "./src-js/wrap.js",
    "./package": "./package.json",
    "./src-js": "./src-js/index.js",
    "./src-js/visit": "./src-js/visit/index.js",
    "./workerd": {
      "types": "./parser.wasm32-wasip1.workerd.d.mts",
      "default": "./parser.wasm32-wasip1.workerd.mjs"
    },
    "./wasm": {
      "types": "./parser.wasm32-wasip1.wasm.d.mts",
      "default": "./parser.wasm32-wasip1.wasm"
    },
    "./wasm.wasm": {
      "types": "./parser.wasm32-wasip1.wasm.d.mts",
      "default": "./parser.wasm32-wasip1.wasm"
    }
  }
}
